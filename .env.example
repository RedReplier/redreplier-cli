# Required: API token from https://redreplier.com/api-tokens
REDREPLIER_API_TOKEN=redreplier_your-api-token-here

# Also accepted, checked after REDREPLIER_API_TOKEN
# REDREPLIER_API_KEY=redreplier_your-api-token-here

# Optional: Custom API base URL (defaults to production)
# REDREPLIER_API_URL=https://ai.redreplier.com/ai-app/api/v1

# Optional: credential profile to use instead of the one marked current
# REDREPLIER_PROFILE=default

# Optional: log every request, redacted, to stderr
# REDREPLIER_DEBUG=1

# Optional: force machine mode (JSON on stdout) even on a TTY
# REDREPLIER_JSON=1

# Optional: strip ANSI colour from all output
# NO_COLOR=1
